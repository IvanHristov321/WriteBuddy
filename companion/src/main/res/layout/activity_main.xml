<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Companion Sync Server"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/start_server_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start WiFi Server"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Server status: Stopped"
        android:textSize="16sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/transfer_status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No transfers yet"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/send_notes_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Show My IP Address" />

</LinearLayout>
